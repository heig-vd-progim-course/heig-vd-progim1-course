{
	"name": "thealivery",
	"private": true,
	"description": "Thealivery, le jeu d'apprentissage du cours ProgIM1",
	"license": "CC-BY-SA-4.0",
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run coverage"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@vitest/coverage-v8": "4.1.12",
		"eslint": "10.15.0",
		"prettier": "3.10.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.73.0",
		"vitest": "4.1.12"
	}
}
